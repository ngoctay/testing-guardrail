# Application
APP_NAME="Guardrails API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/guardrails

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.netlify.app

# AI Configuration (Vercel AI Gateway)
ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh
VERCEL_AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_MODEL=claude-haiku-4-5-20250514
AI_MAX_TOKENS=4096

# GitHub App (optional for backend)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
