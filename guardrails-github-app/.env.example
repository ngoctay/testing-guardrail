# GitHub App Configuration
GITHUB_APP_ID=your-github-app-id
# GITHUB_PRIVATE_KEY: Paste your GitHub App private key here (PEM format)
# Download from: GitHub App Settings > Private keys > Generate a private key
GITHUB_PRIVATE_KEY="<paste-your-github-app-private-key-here>"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Backend API
BACKEND_API_URL=https://your-backend.railway.app
BACKEND_API_KEY=your-backend-api-key

# Environment
NODE_ENV=development
