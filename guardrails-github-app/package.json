{
  "name": "guardrails-github-app",
  "version": "1.0.0",
  "description": "GitHub App for AI Powered Enterprise Guardrails",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "netlify dev",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octokit/auth-app": "7.1.3",
    "@octokit/rest": "21.0.2",
    "@octokit/webhooks": "13.4.1",
    "@octokit/webhooks-methods": "5.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "2.8.2",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "netlify-cli": "17.38.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
